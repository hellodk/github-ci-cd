#!/usr/bin/env bash
# git/v1/hooks/pre-push — org-hooks git v1
# Cheap local gate. Expensive gates (SAST/SCA/IaC) run server-side in CI.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_LIB="$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"
[ -f "$_LIB" ] || _LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../lib" && pwd)/common.sh"
source "$_LIB"

log_info "git pre-push (org-hooks git v$(tool_version "$SCRIPT_DIR/VERSION"))"

if [ -f go.mod ]; then
  require_bin go || exit 1
  go build ./... >/dev/null 2>&1 || { log_error "go build ./... failed"; exit 1; }
  go test ./... >/dev/null 2>&1 || { log_error "go test ./... failed"; exit 1; }
fi

if [ -f package.json ]; then
  if command -v pnpm >/dev/null 2>&1; then
    pnpm -s run lint >/dev/null 2>&1 || { log_error "pnpm lint failed"; exit 1; }
  fi
fi

log_ok "pre-push local checks passed (server-side CI enforces full policy)"
