#!/usr/bin/env bash
# git/v1/hooks/pre-commit — org-hooks git v1
# Fast, deterministic client-side checks. CI re-runs the equivalent policy server-side.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_LIB="$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"
[ -f "$_LIB" ] || _LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../lib" && pwd)/common.sh"
source "$_LIB"

log_info "git pre-commit (org-hooks git v$(tool_version "$SCRIPT_DIR/VERSION"))"

# Staged, added/copied/modified/renamed files
mapfile -t FILES < <(git diff --cached --name-only --diff-filter=ACMR)

FORBIDDEN=('.env' '.env.*' '*.pem' '*.key' 'id_rsa' 'id_dsa' 'credentials.json' '.npmrc' '*.tfstate' '*.tfstate.backup')
SECRET_PATTERNS=('AKIA[0-9A-Z]{16}' 'ghp_[A-Za-z0-9]{36}' 'github_pat_[A-Za-z0-9_]{82}' '-----BEGIN[A-Z ]*PRIVATE KEY-----' 'sk-[A-Za-z0-9]{32}' 'xox[baprs]-[A-Za-z0-9-]{10,}')

fail=0

# 1. Forbidden files
for f in "${FILES[@]:-}"; do
  [ -z "$f" ] && continue
  base="$(basename "$f")"
  for pat in "${FORBIDDEN[@]}"; do
    if [[ "$base" == "$pat" || "$f" == $pat ]]; then
      log_error "forbidden file staged: $f"; fail=1
    fi
  done
done

# 2. Secret scan
for f in "${FILES[@]:-}"; do
  [ -z "$f" ] || [ -f "$f" ] || continue
  for p in "${SECRET_PATTERNS[@]}"; do
    if grep -Eqn "$p" "$f" 2>/dev/null; then
      log_error "possible secret in $f (matched /$p/)"; fail=1
    fi
  done
done

# 3. YAML validation + lint
for f in "${FILES[@]:-}"; do
  case "$f" in
    *.yml|*.yaml)
      if command -v yamllint >/dev/null 2>&1; then
        yamllint -d "{extends: relaxed, rules: {line-length: disable}}" "$f" >/dev/null 2>&1 || { log_error "yamllint failed: $f"; fail=1; }
      else
        python3 - "$f" <<'PY' || { log_error "invalid YAML: $f"; fail=1; }
import sys, yaml
try:
    yaml.safe_load(open(sys.argv[1]))
except Exception as e:
    print(e, file=sys.stderr); sys.exit(1)
PY
      fi
      ;;
  esac
done

# 4. 80-column rule: code <= 80; only comments may exceed, and must carry a Jira ID for the change.
# Documentation and prose files are exempt (the limit targets source code).
MAX=80
JIRA_RE='[A-Z][A-Z0-9]+-[0-9]+'
for f in "${FILES[@]:-}"; do
  [ -z "$f" ] || [ -f "$f" ] || continue
  case "${f##*.}" in
    md|markdown|rst|txt|adoc|html|json|svg|png|jpg|jpeg|gif|pdf) continue ;;
  esac
  lineno=0
  while IFS= read -r line; do
    lineno=$((lineno+1))
    if ((${#line} > MAX)); then
      if [[ "$line" =~ ^[[:space:]]*# ]] || [[ "$line" =~ ^[[:space:]]*// ]] || [[ "$line" =~ ^[[:space:]]*/\* ]] || [[ "$line" =~ ^[[:space:]]*\*\* ]]; then
        if [[ "$line" =~ $JIRA_RE ]]; then
          continue
        else
          log_error "$f:$lineno exceeds $MAX cols and the comment lacks a Jira ID"; fail=1
        fi
      else
        log_error "$f:$lineno exceeds $MAX cols (code line, not a comment)"; fail=1
      fi
    fi
  done < "$f"
done

if ((fail)); then
  log_error "pre-commit failed — use 'git commit --no-verify' only with an audited reason (CI still enforces)"
  exit 1
fi
log_ok "pre-commit passed"
