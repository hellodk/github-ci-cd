#!/usr/bin/env bash
# helm/v1/hooks/commit-msg — org-hooks helm v1
# Same contract as git/v1: Conventional Commits + Jira ID + Signed-off-by.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_LIB="$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"
[ -f "$_LIB" ] || _LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../lib" && pwd)/common.sh"
source "$_LIB"

MSG="$1"
TYPE_RE='^(feat|fix|refactor|perf|docs|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?:[[:space:]].+'
JIRA_RE='[A-Z][A-Z0-9]+-[0-9]+'

subject=""
while IFS= read -r l; do
  if [ -z "$subject" ] && [ -n "$l" ]; then subject="$l"; fi
done < "$MSG"

[ -n "$subject" ] || { log_error "empty commit subject"; exit 1; }
[[ "$subject" =~ $TYPE_RE ]] || { log_error "subject must be Conventional Commits"; exit 1; }
[[ "$subject" =~ $JIRA_RE ]] || { log_error "subject must contain a Jira ID"; exit 1; }
grep -Eq '^Signed-off-by: .+ <.+@.+>' "$MSG" || { log_error "missing 'Signed-off-by' trailer"; exit 1; }
log_ok "commit-msg valid"
