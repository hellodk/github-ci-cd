#!/usr/bin/env bash
# helm/v1/hooks/post-install — installer phase
set -euo pipefail
PHASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$PHASE_DIR/../../../lib/common.sh"
log_ok "helm hooks v$(tool_version "$PHASE_DIR/../VERSION") installed into ${HOOKS_DEST:-<target>/.git/hooks}"
log_info "These git hooks lint charts at commit time. The native Helm lifecycle hooks (helm.sh/hook: pre/post-install, etc.) live in your chart's templates/ and run as Kubernetes Jobs at release time — see policies/helm-lifecycle.md."
