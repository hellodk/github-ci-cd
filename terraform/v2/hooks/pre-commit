#!/usr/bin/env bash
# terraform/v2/hooks/pre-commit — org-hooks terraform v2
# terraform fmt -check + terraform validate on changed .tf files. Skips when terraform absent.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_LIB="$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"
[ -f "$_LIB" ] || _LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../lib" && pwd)/common.sh"
source "$_LIB"

if ! command -v terraform >/dev/null 2>&1; then
  log_warn "terraform not installed; skipping terraform pre-commit"; exit 0
fi

log_info "terraform pre-commit (org-hooks terraform v$(tool_version "$SCRIPT_DIR/VERSION"))"

mapfile -t TF < <(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.tf$' || true)
[ ${#TF[@]} -eq 0 ] && { log_ok "no terraform files changed"; exit 0; }

fail=0
# Group by module directory, run fmt/validate once per dir.
declare -A dirs
for f in "${TF[@]}"; do dirs["$(dirname "$f")"]=1; done
for d in "${!dirs[@]}"; do
  [ -d "$d" ] || continue
  if ! (cd "$d" && terraform fmt -check >/dev/null 2>&1); then
    log_error "terraform fmt needed in: $d (run 'terraform fmt')"; fail=1
  fi
  if ! (cd "$d" && terraform validate >/dev/null 2>&1); then
    log_error "terraform validate failed in: $d"; fail=1
  fi
done

if ((fail)); then log_error "terraform pre-commit failed"; exit 1; fi
log_ok "terraform pre-commit passed"
